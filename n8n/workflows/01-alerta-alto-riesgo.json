{
  "name": "BankShield - Alerta de alto riesgo",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook alerta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bankshield-alert",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Validar secreto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.headers['x-webhook-secret']}}",
              "rightValue": "={{$env.N8N_WEBHOOK_SECRET}}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Notificar equipo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.NOTIFY_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({text: `[BankShield] Alerta ${$json.body.level.toUpperCase()} #${$json.body.alert_id} - ${$json.body.domain} (puntaje ${$json.body.score}). ${$json.body.recommendation}`}) }}"
      }
    },
    {
      "id": "4",
      "name": "Rechazar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        440,
        100
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook alerta": {
      "main": [
        [
          {
            "node": "Validar secreto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar secreto": {
      "main": [
        [
          {
            "node": "Notificar equipo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rechazar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}